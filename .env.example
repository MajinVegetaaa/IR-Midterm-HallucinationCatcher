# Copy to .env, then paste your real keys after the = sign (no quotes, no spaces).
# Free keys: https://console.groq.com/keys
# Several keys are allowed, separated by commas: GROQ_API_KEYS=gsk_abc...,gsk_def...
# If one is rate-limited, the next is used automatically.
GROQ_API_KEYS=
# Optional: any chat model listed at https://console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-120b
